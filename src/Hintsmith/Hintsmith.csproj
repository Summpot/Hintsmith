<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed;PublishAot;PublishReadyToRun;SelfContained;RuntimeIdentifier">
  <PropertyGroup>
    <!-- Runtime library stays portable when a local sample is published with AOT/R2R. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Hintsmith</PackageId>
    <Description>Build-time Avalonia Skia hinting hooks with runtime Normal hinting control.</Description>
    <Authors>Hintsmith contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTasks</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build/*" Pack="true" PackagePath="build/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PackTasks">
    <MSBuild Projects="../Hintsmith.Tasks/Hintsmith.Tasks.csproj" Targets="Restore;Build" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="../Hintsmith.Tasks/bin/$(Configuration)/net10.0/*.dll" PackagePath="tasks/net10.0/" />
      <TfmSpecificPackageFile Include="../Hintsmith.Tasks/bin/$(Configuration)/net472/*.dll" PackagePath="tasks/net472/" />
    </ItemGroup>
  </Target>
</Project>
