<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <HintsmithPackageVersion Condition="'$(HintsmithPackageVersion)' == ''">$(Version)</HintsmithPackageVersion>
    <AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">12.0.0</AvaloniaVersion>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hintsmith" Version="$(HintsmithPackageVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <Compile Include="../Probe/Program.cs" Link="Program.cs" />
    <!-- Reflection is used to inspect Avalonia internals only in this test. -->
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
  </ItemGroup>
</Project>


